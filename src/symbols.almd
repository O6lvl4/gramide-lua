import gramide.package_api
fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("local_binding", "var"), ("label", "label")],
  scopes: [], namespaces: [], callables: ["function_declaration"],
  lexical_owners: false, envelopes: [], unnamed_envelopes: [],
  arguments: "arguments", field_access: "field_access", type_mentions: []
}
